{%- capture icon_class -%}
  Icon Icon--{{ icon | handle }} {{ class | escape }}
{%- endcapture -%}

{%- case icon -%}
  {%- when 'wishlist' -%}
    {%- comment -%} fal fa-heart (outline) {%- endcomment -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24">
      <path
        d="M12.1 8.64l-.1.1-.1-.1C10.14 6.6 7.1 6.6 5.14 8.56c-1.96 1.96-1.96 5.15 0 7.11l6.36 6.36c.31.31.85.31 1.16 0l6.36-6.36c1.96-1.96 1.96-5.15 0-7.11-1.96-1.96-5-1.96-6.96 0z"/>
    </svg>

  {%- when 'user' -%}
    {%- comment -%} fal fa-user {%- endcomment -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24">
      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
    </svg>

  {%- when 'cart' -%}
    {%- comment -%} fal fa-shopping-cart {%- endcomment -%}
    <svg class="{{ icon_class }}" viewBox="0 0 24 24">
      <path d="M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zm10 0c-1.1 0-1.99.9-1.99 2S15.9 22 17 22s2-.9 2-2-.9-2-2-2zM7.16 14.26l.84-2.26h7.45c.75 0 1.41-.41 1.75-1.03L21 4H5.21l-.94-2H1v2h2l3.6 7.59-1.35 3.37C4.52 16.37 5.48 18 7 18h12v-2H7.42c-.14 0-.25-.11-.26-.24l.01-.06z" />
    </svg>

  {%- when 'trash' -%}
    {%- comment -%} fal fa-trash-alt {%- endcomment -%}
    <svg class="{{ icon_class }}" viewBox="0 0 640 640">
      <path d="M232.7 69.9L224 96L128 96C110.3 96 96 110.3 96 128C96 145.7 110.3 160 128 160L512 160C529.7 160 544 145.7 544 128C544 110.3 529.7 96 512 96L416 96L407.3 69.9C402.9 56.8 390.7 48 376.9 48L263.1 48C249.3 48 237.1 56.8 232.7 69.9zM512 208L128 208L149.1 531.1C150.7 556.4 171.7 576 197 576L443 576C468.3 576 489.3 556.4 490.9 531.1L512 208z"/>
    </svg>

  {%- when 'rotate-left' -%}
    <svg class="{{ icon_class }}" viewBox="0 0 640 640">
      <path fill="currentColor" d="M88 256L232 256C241.7 256 250.5 250.2 254.2 241.2C257.9 232.2 255.9 221.9 249 215L202.3 168.3C277.6 109.7 386.6 115 455.8 184.2C530.8 259.2 530.8 380.7 455.8 455.7C380.8 530.7 259.3 530.7 184.3 455.7C174.1 445.5 165.3 434.4 157.9 422.7C148.4 407.8 128.6 403.4 113.7 412.9C98.8 422.4 94.4 442.2 103.9 457.1C113.7 472.7 125.4 487.5 139 501C239 601 401 601 501 501C601 401 601 239 501 139C406.8 44.7 257.3 39.3 156.7 122.8L105 71C98.1 64.2 87.8 62.1 78.8 65.8C69.8 69.5 64 78.3 64 88L64 232C64 245.3 74.7 256 88 256z"/>
    </svg>
{%- endcase -%}